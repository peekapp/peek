{
  "format": 2,
  "sdk": "^0.1.0",
  "id": "peek/ical",
  "version": "0.2.2",
  "kind": "connection",
  "name": "iCalendar",
  "description": "Read events from a private HTTPS calendar feed.",
  "author": "Peek",
  "entry": "index.mjs",
  "icon": "assets/icon.svg",
  "iconColor": "theme",
  "settings": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "timeZone": {
        "type": "string",
        "title": "Time zone",
        "default": "UTC",
        "minLength": 1,
        "maxLength": 100
      },
      "intervalSeconds": {
        "type": "integer",
        "title": "Refresh interval (seconds)",
        "default": 300,
        "minimum": 60,
        "maximum": 86400
      }
    },
    "required": [
      "timeZone",
      "intervalSeconds"
    ]
  },
  "permissions": {
    "internet": true
  },
  "secrets": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "Calendar URL (HTTPS)",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "required": [
      "url"
    ],
    "additionalProperties": false
  },
  "provides": {
    "events": {
      "id": "peek/events",
      "version": "1.0.0",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "events"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "minimum": -8640000000000000,
            "maximum": 8640000000000000
          },
          "to": {
            "type": "integer",
            "minimum": -8640000000000000,
            "maximum": 8640000000000000
          },
          "events": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "kind",
                    "startAt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2200
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "location": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "kind": {
                      "enum": [
                        "timed"
                      ]
                    },
                    "startAt": {
                      "type": "integer",
                      "minimum": -8640000000000000,
                      "maximum": 8640000000000000
                    },
                    "endAt": {
                      "type": "integer",
                      "minimum": -8640000000000000,
                      "maximum": 8640000000000000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "kind",
                    "startDate",
                    "timeZone"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2200
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "location": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "kind": {
                      "enum": [
                        "all-day"
                      ]
                    },
                    "startDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "endDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "timeZone": {
                      "type": "string",
                      "format": "time-zone",
                      "maxLength": 100
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
