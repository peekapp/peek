{
  "format": 3,
  "sdk": "^0.2.0",
  "id": "example/connection",
  "version": "0.1.0",
  "kind": "connection",
  "name": "Sample source",
  "description": "Demonstrates a custom data contract without changes to Peek.",
  "author": "Peek examples",
  "entry": "index.mjs",
  "icon": "assets/icon.svg",
  "iconColor": "theme",
  "settings": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "default": "Hello from an extension"
      }
    },
    "additionalProperties": false
  },
  "permissions": {},
  "provides": {
    "messages": {
      "id": "example/messages",
      "version": "1.0.0",
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 100
      }
    }
  },
  "settingsUi": {
    "blocks": [
      {
        "id": "settings",
        "name": {
          "en": "Settings"
        },
        "description": {
          "en": "Configure this extension."
        },
        "source": "settings",
        "controls": [
          {
            "type": "input",
            "field": "message",
            "label": {
              "en": "message"
            }
          }
        ]
      }
    ]
  }
}
