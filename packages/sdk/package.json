{
  "name": "@peekapp/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Contracts for Peek scenarios and connections",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scenario": {
      "types": "./dist/scenario.d.ts",
      "default": "./dist/scenario.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "default": "./dist/connection.js"
    },
    "./contracts/events": {
      "types": "./dist/contracts/events.d.ts",
      "default": "./dist/contracts/events.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peekapp/peek.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/peekapp/peek/blob/main/docs/extensions.md",
  "bugs": {
    "url": "https://github.com/peekapp/peek/issues"
  }
}
